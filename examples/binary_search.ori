fn binarySearch(int* values, int count, int target) -> int {
    int low = 0;
    int high = count - 1;
    while (low <= high) {
        int mid = low + (high - low) / 2;
        if (values[mid] == target) {
            return mid;
        } else {
            if (values[mid] < target) {
                low = mid + 1;
            } else {
                high = mid - 1;
            }
        }
    }
    return -1;
}

fn main() -> int {
    int* values = alloc int[7];
    values[0] = -4;
    values[1] = -1;
    values[2] = 0;
    values[3] = 3;
    values[4] = 600;
    values[5] = 12;
    values[6] = 20;

    int index = binarySearch(values, 7, 8);
    print(index);
    free(values);
    return 0;
}
